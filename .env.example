# Webhook n8n: inside Docker network wapdiz_app-net use container address or public HTTPS URL
NUXT_N8N_WEBHOOK_URL=http://wapdiz-n8n-1:5678/webhook/CHANGE_ME
NUXT_N8N_AUTH_HEADER_NAME=X-Todo-Ai-Token
NUXT_N8N_AUTH_HEADER_VALUE=CHANGE_ME

# Behind Nginx Proxy Manager set true and set: proxy_set_header X-Forwarded-For $remote_addr;
NUXT_AI_TRUST_PROXY=true

# Optional rate limit overrides (defaults are configured in nuxt.config.ts)
# NUXT_AI_RATE_LIMIT_PER_MINUTE=12
# NUXT_AI_DAILY_REQUEST_LIMIT=200
# NUXT_AI_MAX_CONCURRENT_PER_IP=1
# NUXT_AI_MAX_CONCURRENT_GLOBAL=4
