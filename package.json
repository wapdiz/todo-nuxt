{
  "name": "nuxt-test",
  "type": "module",
  "private": true,
  "scripts": {
    "build-nuxt": "nuxt build",
    "dev": "nuxt dev",
    "start": "nodemon --watch project-config --ext ts,js --exec npm run dev",
    "images:prepare": "npx tsx npm-scripts/picture-prebuild.ts",
    "build:test": "cross-env NODE_ENV=production nuxt generate",
    "build": "cross-env NODE_ENV=production IS_PROD=true nuxt generate && rimraf output/public/robots.txt",
    "preview": "npx nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "stylelint": "stylelint \"**/*.(css|scss|vue)\"",
    "stylelint:fix": "stylelint \"**/*.(css|scss|vue)\" --fix",
    "lint:all": "npm run lint && npm run stylelint",
    "format": "prettier --write .",
    "lint:format": "npm run lint:fix && npm run format",
    "fonts:convert": "npx tsx npm-scripts/fonts-converter.ts",
    "zip": "npx tsx npm-scripts/zip.ts",
    "prepare": "husky",
    "json-server": "nodemon --watch npm-scripts/test-server --ext ts,js,json --exec tsx npm-scripts/test-server/json-server.ts",
    "start:all": "concurrently \"npm run start\" \"npm run json-server\""
  },
  "dependencies": {
    "@nuxt/fonts": "^0.12.1",
    "@nuxtjs/sitemap": "^7.4.11",
    "body-scroll-lock": "^4.0.0-beta.0",
    "gsap": "^3.12.5",
    "inapp-spy": "^4.4.0",
    "json-server": "0.17.4",
    "lenis": "^1.3.25",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "maska": "^3.2.0",
    "nuxt": "4.1.3",
    "nuxt-svgo": "^4.2.6",
    "overlayscrollbars-vue": "^0.5.10",
    "pinia": "^2.1.7",
    "sharp": "^0.34.5",
    "ua-parser-js": "1.0.33",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vue-tippy": "^6.7.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.11.0",
    "@nuxt/eslint-config": "^1.11.0",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/express": "^5.0.6",
    "@types/json-server": "^0.14.8",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.10.1",
    "@types/ua-parser-js": "^0.7.39",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "json-server": "^0.17.4",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "nuxt-svg-sprite-icon": "^2.0.3",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-preset-env": "^10.6.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "sass": "1.94.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "svg2ttf": "^6.0.3",
    "tsx": "^4.21.0",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vue-tsc": "^3.1.5",
    "zip-a-folder": "4.0.4"
  },
  "overrides": {
    "@nuxt/schema": "4.1.3",
    "@bomb.sh/tab": "0.0.14"
  },
  "lint-staged": {
    "*.(js|jsx|ts|tsx|vue)": "eslint",
    "*.(vue|css|scss)": "stylelint"
  }
}
